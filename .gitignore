# ==========================================
# Roamify · Expo React Native .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo & Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
metro-cache/

# Secrets & environment variables (keep only .env.example)
.env
.env.*
!.env.example
*.env

# Native builds (generated via prebuild/EAS)
/ios/
/android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.keystore
*.mobileprovision
*.signing/

# Sanity Studio (keep source only)
studio/node_modules/
studio/dist/
studio/.sanity/

# AI tooling, prompts & agent skills (not for recruiters)
.agents/
.agent/
.claude/
.cursor/
skills-lock.json
AGENTS.md
CLAUDE.md
prompts/
prompt-imgs/

# Logs & caches
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.eslintcache
.stylelintcache
*.tsbuildinfo

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Scratch files (anchored to root so assets/images is NOT ignored)
/images/