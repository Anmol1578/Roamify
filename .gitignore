# ==========================================
# Roamify · Expo React Native .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo & Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
metro-cache/

# Local Environment Variables & Secrets (per AGENTS.md: NEVER commit secrets)
.env
.env.*
.env*.local
*.env
!.env.example

# Native Builds (generated via prebuild/EAS - never edit by hand)
/ios/
/android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.signing/

# Debug & Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
.eslintcache
.stylelintcache

# TypeScript
*.tsbuildinfo

# Operating System Files
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Temporary / Scratch duplicate assets
images/
